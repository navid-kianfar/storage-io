{
  "name": "@storage-io/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "storage-io shared contract: zod v4 schemas, inferred types, enums and helpers for every storage-io API request and response.",
  "keywords": [
    "s3",
    "object-storage",
    "s3-compatible",
    "minio",
    "seaweedfs",
    "ceph",
    "garage",
    "aws-s3",
    "cloudflare-r2",
    "wasabi",
    "storage-management",
    "admin-console",
    "iam",
    "self-hosted",
    "on-premise",
    "zod",
    "contracts",
    "typescript",
    "schema"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navid-kianfar/storage-io.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/navid-kianfar/storage-io/tree/main/packages/contracts#readme",
  "bugs": {
    "url": "https://github.com/navid-kianfar/storage-io/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
