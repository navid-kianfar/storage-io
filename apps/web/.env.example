# Every variable the web app reads. All are optional: the defaults are what
# `pnpm dev` uses against a local API on :3000.

# Base path for API calls. Left at the default, /api is proxied to
# VITE_DEV_API_TARGET by the dev server (see vite.config.ts).
VITE_API_BASE_URL=/api/v1

# Where the dev server proxies /api. Build-time only; not read by the app.
VITE_DEV_API_TARGET=http://localhost:3000

# '1' starts the MSW mock handlers instead of talking to the API. Use
# `pnpm dev:mock` rather than setting this by hand.
VITE_MOCK_API=0

# Shown in the sidebar and the login footer.
VITE_APP_VERSION=0.1.0
