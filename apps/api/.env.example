# storage-io API — every environment variable the API reads.
# Copy to .env and fill in. The API validates this file at boot and refuses to
# start with a list of what is wrong, so a typo is never a mystery at runtime.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The single administrator. There is no sign-up, no password change in the UI
# and no second factor — the Settings page shows these as "Managed by
# environment".
ADMIN_USERNAME=admin

# Either ADMIN_PASSWORD (plain, ≥ 8 characters) or ADMIN_PASSWORD_HASH
# (argon2id PHC string) — set exactly one. The hash is preferred for anything
# beyond a laptop, because a plain password sits in the process environment.
#   Generate one:  node -e "require('hash-wasm').argon2id({password:'your-password',salt:require('crypto').randomBytes(16),parallelism:4,iterations:3,memorySize:65536,hashLength:32,outputType:'encoded'}).then(console.log)"
ADMIN_PASSWORD=change-me-please
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...$...

# HKDF input for the AES-256-GCM key that encrypts storage-server secrets at
# rest. At least 32 characters. CHANGING IT MAKES EVERY STORED SECRET
# UNREADABLE — each server has to be re-entered.
#   Generate one:  openssl rand -base64 48
APP_SECRET=replace-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# SQLite file. Its directory is created if missing. `:memory:` is used by tests.
DATABASE_PATH=./data/storage-io.sqlite

# Set true when the API is served over HTTPS, so the session cookie is Secure.
COOKIE_SECURE=false

# Whether X-Forwarded-For may be believed, and from whom. OFF by default.
#
# X-Forwarded-For is a request header, so any client can write one. Trusting a
# hop that is not really in front of the API lets a caller choose the address the
# allowed-networks list is checked against, the login throttler counts, and every
# activity row records. Only set this when a reverse proxy really is in front.
#
#   TRUST_PROXY=false            ignore X-Forwarded-For entirely (the default)
#   TRUST_PROXY=1                exactly one reverse proxy in front of the API
#   TRUST_PROXY=10.0.0.0/8,192.168.1.10   only these proxies are believed
#
# `true` is deliberately not accepted: it means "believe anybody".
TRUST_PROXY=false

# Extra origins allowed to send cookie-authenticated mutations, comma separated.
# Same-origin always passes. In dev the Vite server proxies /api, so this is only
# needed when the web app is served from a different host.
# ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=info
# Pretty-printed logs. Defaults to true when NODE_ENV=development.
# LOG_PRETTY=true

# Swagger at /api/docs. Defaults to true outside production.
# SWAGGER_ENABLED=true

# Login throttle, per IP.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_SEC=60

# Turn the background health checker off — useful for a one-shot run or a test.
HEALTH_CHECKER_ENABLED=true

# Turn the background bucket-inventory refresher off. With it off, `GET /buckets`
# still answers from whatever the cache last held and per-server bucket
# operations still work — only the periodic size/attribute refresh stops.
INVENTORY_REFRESHER_ENABLED=true

# Turn the IAM background work off: the access-key expiry/rotation sweep and the
# cached S3-user and access-key counts the dashboard shows. With it off, keys with
# an app-tracked expiry keep reading as expired in the API (the merge is computed,
# not stored) but nothing deactivates them at the provider.
IAM_SCHEDULER_ENABLED=true

# Turn the bulk-job engine and its scheduler off. With it off, `/jobs` still
# answers and a job can still be created — the row simply sits in `queued` until
# a process with the engine on picks it up. The e2e suite runs with it off and
# drives the engine directly, so a run is deterministic.
JOB_ENGINE_ENABLED=true

# Where the built web app lives. Set, the API serves it with an SPA fallback for
# every path outside /api and /health, long cache headers on Vite's hashed assets
# and no-cache on index.html. Unset (the default) the API is JSON only, which is
# what you want in development: Vite serves the app on :5173 and proxies /api here.
# The Dockerfile sets it to /app/public.
# WEB_DIST=/app/public
